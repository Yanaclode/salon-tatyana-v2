---
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'Студия красоты Татьяны Рединой — Редкино' } = Astro.props;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer-when-downgrade" />
  <meta name="description" content="Студия красоты Татьяны Рединой в пгт Редкино. Увеличение губ, архитектура бровей, скульптурный массаж, биоревитализация. Запись: +7 (920) 689-44-20" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
</head>
<body class="bg-cream text-dark font-sans antialiased">
  <slot />

  <!-- Cookie Banner -->
  <div id="cookieBanner" class="cookie-banner fixed bottom-0 left-0 right-0 z-50 bg-dark text-white/70 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 px-5 md:px-16 py-5">
    <p class="text-sm leading-relaxed">
      Сайт использует файлы cookie сторонних сервисов для корректного отображения.
      Продолжая использовать сайт, вы соглашаетесь с
      <a href="/privacy" class="text-gold underline underline-offset-2">Политикой конфиденциальности</a>.
    </p>
    <button id="cookieAccept" class="shrink-0 w-full md:w-auto px-7 py-3 bg-gold text-cream text-xs tracking-widest uppercase hover:bg-sand transition-colors cursor-pointer">
      Принять
    </button>
  </div>
</body>
</html>

<script>
  // Cookie
  const banner = document.getElementById('cookieBanner')!;
  if (localStorage.getItem('cookieOk')) banner.classList.add('hidden');
  document.getElementById('cookieAccept')!.addEventListener('click', () => {
    localStorage.setItem('cookieOk', '1');
    banner.classList.add('hidden');
  });
</script>
